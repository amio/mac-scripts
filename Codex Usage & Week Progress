#!/usr/bin/env node

import { spawn } from "node:child_process";
import process from "node:process";
import readline from "node:readline";

const TIMEOUT_MS = 20_000;
const COMPACT_OUTPUT = true;
const codex = spawn(process.env.CODEX_BIN || "codex", ["app-server", "--stdio"], {
  stdio: ["pipe", "pipe", "pipe"],
});
const pending = new Map();
let stderr = "";
let exited = false;

codex.stderr.setEncoding("utf8");
codex.stderr.on("data", (chunk) => {
  stderr = `${stderr}${chunk}`.slice(-8_192);
});

readline.createInterface({ input: codex.stdout }).on("line", (line) => {
  let message;
  try {
    message = JSON.parse(line);
  } catch {
    return;
  }

  const current = pending.get(message.id);
  if (!current) return;

  clearTimeout(current.timeout);
  pending.delete(message.id);
  if (message.error) {
    current.reject(
      new Error(`${current.method} failed: ${message.error.message ?? JSON.stringify(message.error)}`),
    );
  } else {
    current.resolve(message.result);
  }
});

function rejectPending(error) {
  for (const current of pending.values()) {
    clearTimeout(current.timeout);
    current.reject(error);
  }
  pending.clear();
}

codex.on("error", rejectPending);
codex.stdin.on("error", rejectPending);
codex.on("exit", (code, signal) => {
  exited = true;
  const detail = stderr.trim();
  rejectPending(
    new Error(
      `codex app-server exited (code=${code ?? "null"}, signal=${signal ?? "null"})` +
        (detail ? `\n${detail}` : ""),
    ),
  );
});

function send(message) {
  if (exited || !codex.stdin.writable) {
    throw new Error("codex app-server stdin is not writable");
  }
  codex.stdin.write(`${JSON.stringify(message)}\n`);
}

function request(id, method, params) {
  return new Promise((resolve, reject) => {
    const timeout = setTimeout(() => {
      pending.delete(id);
      reject(new Error(`${method} timed out after ${TIMEOUT_MS} ms`));
    }, TIMEOUT_MS);

    pending.set(id, { method, resolve, reject, timeout });
    try {
      send(params === undefined ? { method, id } : { method, id, params });
    } catch (error) {
      clearTimeout(timeout);
      pending.delete(id);
      reject(error);
    }
  });
}

async function close() {
  if (exited) return;
  codex.stdin.end();
  await Promise.race([
    new Promise((resolve) => codex.once("exit", resolve)),
    new Promise((resolve) => setTimeout(resolve, 250)),
  ]);
  if (!exited) codex.kill("SIGTERM");
}

function formatLocalIso(date) {
  const pad = (value) => String(value).padStart(2, "0");
  const offsetMinutes = -date.getTimezoneOffset();
  const sign = offsetMinutes >= 0 ? "+" : "-";
  const offset = Math.abs(offsetMinutes);

  return (
    `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}` +
    `T${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}` +
    `${sign}${pad(Math.floor(offset / 60))}:${pad(offset % 60)}`
  );
}

function normalizeWindow(window) {
  if (!window) return null;

  const usedPercent = Number(window.usedPercent);
  const resetsAt = Number.isFinite(window.resetsAt) ? window.resetsAt : null;
  const resetDate = resetsAt === null ? null : new Date(resetsAt * 1_000);

  return {
    usedPercent: Number.isFinite(usedPercent) ? usedPercent : null,
    remainingPercent: Number.isFinite(usedPercent)
      ? Math.min(100, Math.max(0, 100 - usedPercent))
      : null,
    windowMinutes: Number.isFinite(window.windowDurationMins)
      ? window.windowDurationMins
      : null,
    resetsAt,
    resetsAtIso: resetDate?.toISOString() ?? null,
    resetsAtLocal: resetDate ? formatLocalIso(resetDate) : null,
  };
}

function normalizeLimit(limit) {
  const id = limit.limitId || "codex";
  return {
    id,
    name: limit.limitName || id,
    planType: limit.planType ?? null,
    primary: normalizeWindow(limit.primary),
    secondary: normalizeWindow(limit.secondary),
    credits: limit.credits ?? null,
    individualLimit: limit.individualLimit ?? null,
    spendControlReached: limit.spendControlReached ?? null,
    rateLimitReachedType: limit.rateLimitReachedType ?? null,
  };
}

function formatCompact(limit, now = Date.now()) {
  const { remainingPercent, windowMinutes, resetsAt } = limit.primary ?? {};
  if (
    !Number.isFinite(remainingPercent) ||
    !Number.isFinite(windowMinutes) ||
    windowMinutes <= 0 ||
    !Number.isFinite(resetsAt)
  ) {
    throw new Error("codex primary rate limit is missing compact-output fields");
  }

  const remainingWindowProgress = Math.min(
    100,
    Math.max(0, Math.round(((resetsAt * 1_000 - now) / (windowMinutes * 60_000)) * 100)),
  );
  return `${Math.round(remainingPercent)}/${remainingWindowProgress}`;
}

async function main() {
  try {
    await request(1, "initialize", {
      clientInfo: { name: "codex_limit_reader", version: "1.0.0" },
      capabilities: { optOutNotificationMethods: ["account/rateLimits/updated"] },
    });
    send({ method: "initialized" });

    const result = await request(2, "account/rateLimits/read");
    if (!result?.rateLimits) {
      throw new Error("account/rateLimits/read returned no codex rate limit");
    }
    const limit = normalizeLimit(result.rateLimits);
    const output = COMPACT_OUTPUT ? formatCompact(limit) : JSON.stringify(limit, null, 2);
    process.stdout.write(`${output}\n`);
  } finally {
    await close();
  }
}

main().catch((error) => {
  process.stderr.write(`codex-status-limits: ${error.message}\n`);
  process.exitCode = 1;
});
