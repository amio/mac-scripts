#!/usr/bin/env node

import { spawn } from "node:child_process";
import process from "node:process";
import readline from "node:readline";

const TIMEOUT_MS = 20_000;
const COMPACT_OUTPUT = true;
const FIVE_HOURS_MINUTES = 5 * 60;
const ONE_WEEK_MINUTES = 7 * 24 * 60;

const codex = spawn(process.env.CODEX_BIN || "codex", ["app-server", "--stdio"], {
  stdio: ["pipe", "pipe", "pipe"],
});
const pending = new Map();
let stderr = "";
let exited = false;

codex.stderr.setEncoding("utf8");
codex.stderr.on("data", (chunk) => {
  stderr = `${stderr}${chunk}`.slice(-8_192);
});

readline.createInterface({ input: codex.stdout }).on("line", (line) => {
  let message;
  try {
    message = JSON.parse(line);
  } catch {
    return;
  }

  const current = pending.get(message.id);
  if (!current) return;

  clearTimeout(current.timeout);
  pending.delete(message.id);
  if (message.error) {
    current.reject(
      new Error(`${current.method} failed: ${message.error.message ?? JSON.stringify(message.error)}`),
    );
  } else {
    current.resolve(message.result);
  }
});

function rejectPending(error) {
  for (const current of pending.values()) {
    clearTimeout(current.timeout);
    current.reject(error);
  }
  pending.clear();
}

codex.on("error", rejectPending);
codex.stdin.on("error", rejectPending);
codex.on("exit", (code, signal) => {
  exited = true;
  const detail = stderr.trim();
  rejectPending(
    new Error(
      `codex app-server exited (code=${code ?? "null"}, signal=${signal ?? "null"})` +
        (detail ? `\n${detail}` : ""),
    ),
  );
});

function send(message) {
  if (exited || !codex.stdin.writable) {
    throw new Error("codex app-server stdin is not writable");
  }
  codex.stdin.write(`${JSON.stringify(message)}\n`);
}

function request(id, method, params) {
  return new Promise((resolve, reject) => {
    const timeout = setTimeout(() => {
      pending.delete(id);
      reject(new Error(`${method} timed out after ${TIMEOUT_MS} ms`));
    }, TIMEOUT_MS);

    pending.set(id, { method, resolve, reject, timeout });
    try {
      send(params === undefined ? { method, id } : { method, id, params });
    } catch (error) {
      clearTimeout(timeout);
      pending.delete(id);
      reject(error);
    }
  });
}

async function close() {
  if (exited) return;
  codex.stdin.end();
  await Promise.race([
    new Promise((resolve) => codex.once("exit", resolve)),
    new Promise((resolve) => setTimeout(resolve, 250)),
  ]);
  if (!exited) codex.kill("SIGTERM");
}

function formatLocalIso(date) {
  const pad = (value) => String(value).padStart(2, "0");
  const offsetMinutes = -date.getTimezoneOffset();
  const sign = offsetMinutes >= 0 ? "+" : "-";
  const offset = Math.abs(offsetMinutes);

  return (
    `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}` +
    `T${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}` +
    `${sign}${pad(Math.floor(offset / 60))}:${pad(offset % 60)}`
  );
}

function finiteNumber(value) {
  if (typeof value === "number") return Number.isFinite(value) ? value : null;
  if (typeof value !== "string" || value.trim() === "") return null;

  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : null;
}

function normalizeWindow(window) {
  if (!window || typeof window !== "object") return null;

  const usedPercent = finiteNumber(window.usedPercent);
  const candidateResetsAt = finiteNumber(window.resetsAt);
  const windowMinutes = finiteNumber(window.windowDurationMins);
  const candidateResetDate =
    candidateResetsAt === null ? null : new Date(candidateResetsAt * 1_000);
  const resetDate =
    candidateResetDate && Number.isFinite(candidateResetDate.getTime())
      ? candidateResetDate
      : null;
  const resetsAt = resetDate ? candidateResetsAt : null;

  return {
    usedPercent,
    remainingPercent:
      usedPercent === null ? null : Math.min(100, Math.max(0, 100 - usedPercent)),
    windowMinutes,
    resetsAt,
    resetsAtIso: resetDate?.toISOString() ?? null,
    resetsAtLocal: resetDate ? formatLocalIso(resetDate) : null,
  };
}

function normalizeLimit(limit) {
  const id = limit.limitId || "codex";
  return {
    id,
    name: limit.limitName || id,
    planType: limit.planType ?? null,
    primary: normalizeWindow(limit.primary),
    secondary: normalizeWindow(limit.secondary),
    credits: limit.credits ?? null,
    individualLimit: limit.individualLimit ?? null,
    spendControlReached: limit.spendControlReached ?? null,
    rateLimitReachedType: limit.rateLimitReachedType ?? null,
  };
}

function collectRateLimits(result) {
  const byId = result.rateLimitsByLimitId;
  const isSnapshot = (snapshot) =>
    snapshot &&
    typeof snapshot === "object" &&
    ("primary" in snapshot || "secondary" in snapshot || "limitId" in snapshot);
  const fallbackById =
    byId && typeof byId === "object" ? Object.values(byId).find(isSnapshot) : null;
  const snapshot = [byId?.codex, result.rateLimits, fallbackById].find(isSnapshot);

  return snapshot ? [normalizeLimit(snapshot)] : [];
}

function findWindow(limits, matchesDuration) {
  for (const limit of limits) {
    for (const slot of ["primary", "secondary"]) {
      const window = limit[slot];
      if (Number.isFinite(window?.windowMinutes) && matchesDuration(window.windowMinutes)) {
        return window;
      }
    }
  }
  return null;
}

function requireOutputFields(window, label) {
  if (
    !Number.isFinite(window?.remainingPercent) ||
    !Number.isFinite(window?.windowMinutes) ||
    !Number.isFinite(window?.resetsAt)
  ) {
    throw new Error(`${label} rate limit is missing balance or reset fields`);
  }
}

function formatCompact(limits, now = Date.now()) {
  const shortWindow = findWindow(
    limits,
    (durationMinutes) => durationMinutes === FIVE_HOURS_MINUTES,
  );
  if (shortWindow) {
    requireOutputFields(shortWindow, "short-window");
    const remainingHours = Math.max(0, (shortWindow.resetsAt * 1_000 - now) / 3_600_000);
    return `${Math.round(shortWindow.remainingPercent)}%/${remainingHours.toFixed(1)}H`;
  }

  const weekWindow = findWindow(limits, (durationMinutes) => durationMinutes === ONE_WEEK_MINUTES);
  if (!weekWindow) {
    throw new Error("no short-window or 1-week rate limit was returned");
  }
  requireOutputFields(weekWindow, "1-week");

  const resetWeekProgress = Math.min(
    100,
    Math.max(
      0,
      Math.round(((weekWindow.resetsAt * 1_000 - now) / (weekWindow.windowMinutes * 60_000)) * 100),
    ),
  );
  return `${Math.round(weekWindow.remainingPercent)}%/${resetWeekProgress}%`;
}

async function main() {
  try {
    await request(1, "initialize", {
      clientInfo: { name: "codex_limit_reader", version: "1.0.0" },
      capabilities: { optOutNotificationMethods: ["account/rateLimits/updated"] },
    });
    send({ method: "initialized" });

    const result = await request(2, "account/rateLimits/read");
    const limits = collectRateLimits(result ?? {});
    if (limits.length === 0) {
      throw new Error("account/rateLimits/read returned no codex rate limit");
    }

    const output = COMPACT_OUTPUT
      ? formatCompact(limits)
      : JSON.stringify(limits.length === 1 ? limits[0] : limits, null, 2);
    process.stdout.write(`${output}\n`);
  } finally {
    await close();
  }
}

main().catch((error) => {
  process.stderr.write(`codex-status-limits: ${error.message}\n`);
  process.exitCode = 1;
});
