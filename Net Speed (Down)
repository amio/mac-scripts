#!/bin/zsh
# Read one network-counter sample for a menu-bar refresh; never sleeps.

set -u

NET_SPEED_SHOW="${NET_SPEED_SHOW:-down}" # both, up, or down
IFACE="${IFACE:-}"                       # empty means the default route
STATE_DIR="${TMPDIR:-/tmp}"

case "$NET_SPEED_SHOW" in
  both|up|down) ;;
  *) print -u2 "NET_SPEED_SHOW must be both, up, or down"; exit 2 ;;
esac

show_empty() {
  if [[ "$NET_SPEED_SHOW" == both ]]; then
    print -r -- '↓ —  ↑ —'
  else
    print -r -- '—'
  fi
}

format_rate() {
  awk -v rate="$1" 'BEGIN {
    if (rate >= 1000000000) printf "%.0f GB/s", rate / 1000000000
    else if (rate >= 1000000) printf "%.0f MB/s", rate / 1000000
    else if (rate >= 1000) printf "%.0f KB/s", rate / 1000
    else printf "%.0f B/s", rate
  }'
}

iface="$IFACE"
if [[ -z "$iface" ]]; then
  iface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
fi

if [[ -z "$iface" ]]; then
  print -u2 "cannot find the default network interface"
  exit 1
fi

current=($(
  netstat -ib -I "$iface" 2>/dev/null |
    awk -v iface="$iface" '
      $1 == iface &&
      $7 ~ /^[0-9]+$/ &&
      $10 ~ /^[0-9]+$/ {
        print $7, $10
        exit
      }
    '
))

if (( ${#current} < 2 )); then
  print -u2 "cannot read byte counters for interface $iface"
  exit 1
fi

rx=$current[1]
tx=$current[2]
now="${(%):-%D{%s.%N}}"
state_file="${STATE_FILE:-$STATE_DIR/menubar-net-speed-${iface}.state}"

if [[ ! -r "$state_file" ]]; then
  print -r -- "$now $rx $tx" >| "$state_file"
  show_empty
  exit 0
fi

read -r previous_time previous_rx previous_tx < "$state_file"

rates="$(awk \
  -v now="$now" \
  -v previous="$previous_time" \
  -v rx="$rx" \
  -v previous_rx="$previous_rx" \
  -v tx="$tx" \
  -v previous_tx="$previous_tx" '
  BEGIN {
    dt = now - previous
    if (dt <= 0) exit

    down = (rx - previous_rx) / dt
    up = (tx - previous_tx) / dt

    if (down < 0) down = 0
    if (up < 0) up = 0

    printf "%.6f %.6f %.6f", down, up, dt
  }'
)"

print -r -- "$now $rx $tx" >| "$state_file"

if [[ -z "$rates" ]]; then
  show_empty
  exit 0
fi

read -r download upload dt <<< "$rates"

down_text="$(format_rate "$download")"
up_text="$(format_rate "$upload")"

case "$NET_SPEED_SHOW" in
  down)
    print -r -- "$down_text"
    ;;
  up)
    print -r -- "$up_text"
    ;;
  both)
    printf '↓ %s  ↑ %s\n' "$down_text" "$up_text"
    ;;
esac

if [[ "${DETAIL:-0}" == 1 ]]; then
  printf '%s · cached delta %.2fs\n' "$iface" "$dt"
fi